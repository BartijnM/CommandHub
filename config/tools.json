{
  "tools": [
    {
      "name": "git_version",
      "description": "Show the installed Git version",
      "command": "git",
      "arguments": ["--version"],
      "parameters": []
    },
    {
      "name": "rust_version",
      "description": "Toont de geïnstalleerde Rust-versie",
      "command": "rustc",
      "arguments": ["--version"],
      "parameters": []
    },
    {
      "name": "cargo_version",
      "description": "Toont de geïnstalleerde Cargo-versie",
      "command": "cargo",
      "arguments": ["--version"],
      "parameters": []
    },
    {
      "name": "hostname",
      "description": "Toont de computernaam",
      "command": "hostname",
      "arguments": [],
      "parameters": []
    },
    {
      "name": "whoami",
      "description": "Toont de gebruiker waaronder CommandHub draait",
      "command": "whoami",
      "arguments": [],
      "parameters": []
    },
    {
      "name": "ping_localhost",
      "description": "Ping localhost vier keer op Windows",
      "command": "ping",
      "arguments": ["-n", "4", "127.0.0.1"],
      "parameters": [],
      "timeout": 10000
    },
    {
      "name": "rust_details",
      "description": "Toon korte of uitgebreide Rust-versie-informatie",
      "command": "rustc",
      "arguments": ["{detail}"],
      "parameters": [
        {
          "name": "detail",
          "type": "string",
          "required": true,
          "allowed_values": ["--version", "-vV"]
        }
      ],
      "timeout": 10000
    },
    {
      "name": "git_recent",
      "description": "Toon een begrensd aantal recente commits",
      "command": "git",
      "arguments": [
        "--no-pager",
        "log",
        "-n",
        "{count}",
        "--oneline",
        "--no-decorate",
        "--"
      ],
      "parameters": [
        {
          "name": "count",
          "type": "string",
          "required": true,
          "allowed_values": ["1", "3", "5"]
        }
      ],
      "timeout": 10000
    },
    {
      "name": "git_diff_view",
      "description": "Toon gewijzigde bestandsnamen of een diffstat",
      "command": "git",
      "arguments": [
        "--no-pager",
        "diff",
        "--no-ext-diff",
        "--no-textconv",
        "{view}",
        "--"
      ],
      "parameters": [
        {
          "name": "view",
          "type": "string",
          "required": true,
          "allowed_values": ["--stat", "--name-only"]
        }
      ],
      "timeout": 10000
    },
    {
      "name": "list_directory",
      "description": "Toon bestanden en mappen binnen de CommandHub-projectmap",
      "command": "powershell.exe",
      "arguments": [
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "C:/xampp/htdocs/Educom/Cases/CommandHub/scripts/list-directory.ps1",
        "{path}"
      ],
      "parameters": [
        {
          "name": "path",
          "type": "string",
          "required": true,
          "allowed_roots": ["C:/xampp/htdocs/Educom/Cases/CommandHub"]
        }
      ],
      "timeout": 10000
    }
  ]
}
